# .env.example — 环境变量占位模板
# 复制为 .env（已被 .gitignore 忽略，永不提交）并填入真实值。
# DB_PASSWORD / LLM_API_KEY / JWT_SECRET 为必填 secret。
# 其它 DB_* / LLM_* 是可选覆盖项，默认注释，避免复制后覆盖 profile.yaml。

# 数据库 secret
DB_PASSWORD=

# 可选数据库覆盖（需要时取消注释）
# DB_HOST=
# DB_PORT=
# DB_NAME=
# DB_USER=

# LLM secret
LLM_API_KEY=

# 可选 LLM 覆盖（需要时取消注释）
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_TEMPERATURE=

# 应用 secret
JWT_SECRET=

# 其它可选应用配置（需要时取消注释）
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# MODEL_PATH=./models
