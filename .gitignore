# .gitignore
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so
.*.so

# Distribution / packaging
.Python
build/
develop-egg.pth
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Logs and output
output/
*.log

# Environment / secrets (never commit real credentials)
.env
backend/.env
.env.*
!.env.example

.venv/

# Pytest
.pytest_cache/

# Process ID files
*.process_id

.opencode/
opencode.json
docs/superpowers/
.codegraph/
