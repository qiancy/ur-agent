{
  "name": "Uni-Resource Agent Frontend",
  "description": "Gradio-based frontend for Uni-Resource Agent with multiple UI designs",
  "version": "1.0.0",
  "author": "Uni-Resource Team",
  "license": "MIT",
  "repository": "https://github.com/unires/unires-agent",
  "keywords": ["frontend", "ui", "gradio", "chat", "agent"],
  "dependencies": {
    "gradio": ">=6.0.0",
    "requests": ">=2.28.0",
    "langchain": ">=0.1.0"
  },
  "main": "src/frontend.py",
  "scripts": {
    "start": "python src/frontend.py",
    "dev": "python -m gradio src/frontend.py"
  },
  "config": {
    "frontend": {
      "default_theme": "soft",
      "port": 7860,
      "host": "0.0.0.0",
      "debug": true
    }
  }
}